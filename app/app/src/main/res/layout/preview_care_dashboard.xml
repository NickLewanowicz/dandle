<?xml version="1.0" encoding="utf-8"?>
<!--
    Static widget-picker preview for the CareDashboard widget (UX-review W7). Plain
    RemoteViews-compatible views (no Glance): child-name header (bold, full contrast —
    T4/W8), the ACCENTED running-timer row FIRST reading as state ("Asleep since HH:MM ·
    elapsed", persona round 2 / Priya P2), then the Last feed / Last diaper / Last nap /
    Last pump rows. Mirrors CareDashboardContent's compact branch (running row position,
    wording, order, and CareRow metrics); literal baseline colors (see preview_widget_bg.xml).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/preview_widget_bg"
    android:padding="10dp">

    <!-- T4/W8 child-name header: bold, full contrast — the widget's WHO. -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingBottom="4dp"
        android:text="Milo"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#1D1B20"
        android:maxLines="1" />

    <!-- Running row: FIRST, a rounded primaryContainer chip reading as STATE
         ("Asleep since HH:MM · elapsed"), not a stop button (persona round 2).
         Colors are the onPrimaryContainer literals (W6). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/preview_chip_running"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_bb_sleep"
            android:tint="#21005D"
            android:contentDescription="@string/care_dashboard_widget_label" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Asleep since 13:05"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#21005D"
            android:maxLines="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1h 10m"
            android:textSize="12sp"
            android:textColor="#21005D"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_bb_feeding"
            android:tint="#1D1B20"
            android:contentDescription="@string/care_dashboard_widget_label" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Last feed"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#1D1B20"
            android:maxLines="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12m · Amount: 120"
            android:textSize="12sp"
            android:textColor="#1D1B20"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_bb_diaper"
            android:tint="#1D1B20"
            android:contentDescription="@string/care_dashboard_widget_label" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Last diaper"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#1D1B20"
            android:maxLines="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="34m · Wet"
            android:textSize="12sp"
            android:textColor="#1D1B20"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_bb_sleep"
            android:tint="#1D1B20"
            android:contentDescription="@string/care_dashboard_widget_label" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Last nap"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#1D1B20"
            android:maxLines="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2h · 45m"
            android:textSize="12sp"
            android:textColor="#1D1B20"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_bb_pumping"
            android:tint="#1D1B20"
            android:contentDescription="@string/care_dashboard_widget_label" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Last pump"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#1D1B20"
            android:maxLines="1" />

        <!-- W9: amount 0 (failed-sync pump) reads as unknown — only the since text shows. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="9h"
            android:textSize="12sp"
            android:textColor="#1D1B20"
            android:maxLines="1" />
    </LinearLayout>
</LinearLayout>

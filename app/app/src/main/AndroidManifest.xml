<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Baby Buddy is self-hosted; every screen talks to the user's own server. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Configure screens (spec §7.3): long-press → Configure. -->
        <activity
            android:name=".widget.QuickActionsConfigActivity"
            android:exported="false" />
        <activity
            android:name=".widget.CareDashboardConfigActivity"
            android:exported="false" />

        <receiver
            android:name=".widget.QuickActionsWidgetReceiver"
            android:exported="false"
            android:label="@string/quick_actions_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_actions_widget_info" />
        </receiver>

        <!-- WorkManager on-demand init (perf: cold start): the default androidx.startup
             initializer runs on every process start BEFORE Application.onCreate; removing it
             moves WM construction to the first getInstance, which App.onCreate routes through
             the application scope (off the main/first-frame path). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <receiver
            android:name=".widget.CareDashboardWidgetReceiver"
            android:exported="false"
            android:label="@string/care_dashboard_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/care_dashboard_widget_info" />
        </receiver>
    </application>
</manifest>
